# ==========================================
# PENSA UMaT Membership - Environment Variables
# ==========================================

# 1. Turso Cloud SQLite (Required for persistent data on Vercel)
# Create a free database at https://turso.tech
# Run: turso db create pensa-umat
# Run: turso db show pensa-umat --url
# Run: turso db tokens create pensa-umat
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# 2. Executive Session Secret (Cryptographic HMAC-SHA256 key)
# Generate a strong 32+ character random secret
SESSION_SECRET=pensa_umat_production_secret_key_change_in_production_2026

# Note: In local development, if TURSO_DATABASE_URL is not provided,
# the app will automatically fall back to local SQLite at data/pensa.db.
